# 复制本文件为 .env.local 并填入真实值。
# .env.local 已被根目录 .gitignore 忽略，永远不会进入 GitHub。

# Supabase（前端会用，因此带 NEXT_PUBLIC_ 前缀，会打包进浏览器）
# 这两项不是机密，安全性由 schema.sql 的行级安全 RLS 保证
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 是否启用 Google OAuth 2.0 登录（true / false）
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# DeepSeek 密钥：仅服务端读取，不带 NEXT_PUBLIC_ 前缀，绝不能进浏览器
DEEPSEEK_API_KEY=your-deepseek-api-key

# ---- v3.1 可插拔组件：不配置也会自动降级，不影响主应用运行 ----

# AI provider：auto / deepseek / openai / huggingface
AI_PROVIDER=auto
OPENAI_API_KEY=
HF_API_TOKEN=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_MS=30000

# Redis 缓存：留空时使用进程内 TTL 缓存；docker-compose 内为 redis://redis:6379
REDIS_URL=
CACHE_TTL_SECONDS=60

# MongoDB 可选事件存储（非权威数据，权威数据在 Supabase PostgreSQL）
MONGODB_URI=
MONGODB_DB=cortex
MONGODB_COLLECTION=events

# 前端 API 基址（留空表示同源）与日志级别
NEXT_PUBLIC_API_URL=
LOG_LEVEL=info

# ---- Waitlist 运营：全部可选，不配置时自动降级，不影响名单入库 ----

# 事务性确认邮件（Resend）。两项都填才会发信；留空则跳过，提交照样成功。
# 发件域名必须在 Resend 验证过，否则 Resend 会拒收（写入不受影响）。
RESEND_API_KEY=
WAITLIST_MAIL_FROM=Relaywork <hello@your-domain.com>
WAITLIST_REPLY_TO=
WAITLIST_CONFIRM_ENABLED=true
MAIL_TIMEOUT_MS=5000

# 名单后台 /waitlist-admin：两项都填才启用，缺任一项接口都拒绝访问。
# service_role 是高权限密钥，只在服务端读取，绝不能加 NEXT_PUBLIC_ 前缀。
# 不配置也没关系，名单可直接在 Supabase 控制台查看。
WAITLIST_ADMIN_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
WAITLIST_ADMIN_MAX_ROWS=200
